[gd_resource type="Resource" script_class="ToolDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/tool_definition.gd" id="1_tool_definit"]

[resource]
script = ExtResource("1_tool_definit")
id = &"torque_wrench"
display_name = "Torque wrench"
category = 3
actions = PackedStringArray("tighten", "torque")
uses_socket = true
can_final_torque = true
ui_glyph = "TW"
hotbar_slot = 2
description = "Click-type torque wrench. Set it with the mouse wheel; it releases at the set value. Never used for loosening."
