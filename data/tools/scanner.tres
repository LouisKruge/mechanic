[gd_resource type="Resource" script_class="ToolDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/tool_definition.gd" id="1_tool_definit"]

[resource]
script = ExtResource("1_tool_definit")
id = &"scanner"
display_name = "Diagnostic scanner"
category = 4
