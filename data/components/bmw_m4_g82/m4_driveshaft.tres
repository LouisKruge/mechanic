[gd_resource type="Resource" script_class="ComponentDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/component_definition.gd" id="1_component_de"]
[ext_resource type="Script" path="res://scripts/data/dependency_condition.gd" id="2_dependency_c"]

[sub_resource type="Resource" id="cond_1"]
script = ExtResource("2_dependency_c")
kind = &"world_flag"
subject_id = &"lift_raised"
message = "the vehicle is not raised on the lift"

[sub_resource type="Resource" id="cond_2"]
script = ExtResource("2_dependency_c")
kind = &"component_installed"
subject_id = &"m4_exhaust_system"
expected = false

[resource]
script = ExtResource("1_component_de")
id = &"m4_driveshaft"
display_name = "Driveshaft"
category = 7
compatible_with = PackedStringArray("bmw_m4_g82")
mass_kg = 12.0
purchase_price = 1500
removal_dependencies = Array[ExtResource("2_dependency_c")]([SubResource("cond_1"), SubResource("cond_2")])
