[gd_resource type="Resource" script_class="FaultDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/fault_definition.gd" id="1_fault_defini"]

[resource]
script = ExtResource("1_fault_defini")
id = &"hose_seepage"
display_name = "Coolant hose seepage"
description = "The hose end has hardened and seeps coolant at the clamp under pressure."
discovery_methods = PackedStringArray("flashlight", "pressure_test")
visual_clue = "Dried coolant residue crusted around the lower hose end and clamp."
leak_rate_l_per_h = 1.5
