[resource]
script = ExtResource("1_job_definiti")
id = &"job_001"
title = "JOB 001 — CHARGING SYSTEM FAILURE"
vehicle_id = &"project_c01"
customer_complaint = "\"Battery warning light stays on. Vehicle struggles to start after driving.\""
technician_notes = "Confirm the fault with the scanner before replacing parts. Isolate the battery before electrical work. All torque figures in this workshop are fictional demonstration values."
objectives = Array[ExtResource("2_job_objectiv")]([SubResource("objective_1"), SubResource("objective_3"), SubResource("objective_5"), SubResource("objective_7"), SubResource("objective_9"), SubResource("objective_11"), SubResource("objective_13"), SubResource("objective_15"), SubResource("objective_17"), SubResource("objective_20"), SubResource("objective_22"), SubResource("objective_25"), SubResource("objective_27"), SubResource("objective_29"), SubResource("objective_32"), SubResource("objective_35"), SubResource("objective_38"), SubResource("objective_40"), SubResource("objective_43"), SubResource("objective_45"), SubResource("objective_47"), SubResource("objective_49")])
completion_requirements = Array[ExtResource("3_dependency_c")]([SubResource("cond_51"), SubResource("cond_52"), SubResource("cond_53"), SubResource("cond_54"), SubResource("cond_55"), SubResource("cond_56"), SubResource("cond_57"), SubResource("cond_58"), SubResource("cond_59")])
supplied_parts = {
"alternator": 1
}
labour_payment = 180
