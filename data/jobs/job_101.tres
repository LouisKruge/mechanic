[resource]
script = ExtResource("1_job_definiti")
id = &"job_101"
title = "JOB 101 — LT COOLANT LEAK"
vehicle_id = &"bmw_m4_g82"
customer_complaint = "\"Coolant level warning after motorway drives. No puddle on the driveway.\""
technician_notes = "Charge-air cooling circuit (low temperature). Confirm the leak before replacing parts. Drain into a pan, bleed with the scanner routine after refilling, and pressure-test before handover. All capacities and torques are fictional demonstration values."
objectives = Array[ExtResource("2_job_objectiv")]([SubResource("objective_1"), SubResource("objective_3"), SubResource("objective_5"), SubResource("objective_7"), SubResource("objective_9"), SubResource("objective_11"), SubResource("objective_13"), SubResource("objective_15"), SubResource("objective_17"), SubResource("objective_19"), SubResource("objective_22"), SubResource("objective_24"), SubResource("objective_26"), SubResource("objective_29"), SubResource("objective_32"), SubResource("objective_34"), SubResource("objective_36"), SubResource("objective_41"), SubResource("objective_43"), SubResource("objective_45"), SubResource("objective_47"), SubResource("objective_49")])
completion_requirements = Array[ExtResource("3_dependency_c")]([SubResource("cond_51"), SubResource("cond_52"), SubResource("cond_53"), SubResource("cond_54"), SubResource("cond_55"), SubResource("cond_56"), SubResource("cond_57"), SubResource("cond_58"), SubResource("cond_59"), SubResource("cond_60"), SubResource("cond_61"), SubResource("cond_62"), SubResource("cond_63"), SubResource("cond_64")])
supplied_parts = {
"m4_cc_hose": 1
}
supplied_fluids = {
"coolant_lt": 6.0
}
supplied_hardware = {
"hose_clamp_spring": 2,
"brace_bolt_m10": 2
}
labour_payment = 240
